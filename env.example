# Copie este arquivo para ".env" e preencha os valores antes de rodar o projeto.
# NÃO coloque sua chave real aqui neste arquivo (env.example) nem faça commit do .env.

# Chave de API do Google AI Studio (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# (Opcional) Nome do modelo Gemini a ser usado. Se não definido, usa o padrão do código.
GEMINI_MODEL=
